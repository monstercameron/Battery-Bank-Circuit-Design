  (text "2.5G switch RTL8372N + RTL8221B (RJ45 PHY) + router module"
    (exclude_from_sim no)
    (at 20 20 0)
    (effects
      (font
        (size 2 2))
      (justify left))
    (uuid "23f05c82-b2d6-5bd4-8de1-e9d715b96e17"))
  (text "Switch ports P0-P3 = USB-C ports 1-4 (PHY-to-PHY to each RTL8156BG). S0 -> router SerDes (LAN). S1 -> RTL8221B -> RJ45 (WAN, PoE in)."
    (exclude_from_sim no)
    (at 20 23.5 0)
    (effects
      (font
        (size 1.5 1.5))
      (justify left))
    (uuid "0debabbd-9194-5596-bb82-a262c6412513"))
  (text "Management: the router owns the switch (DSA) over SMDC/SMDIO; switch MDC0/MDIO0 manages the RTL8221B. SDK firmware in SPI flash."
    (exclude_from_sim no)
    (at 20 27 0)
    (effects
      (font
        (size 1.5 1.5))
      (justify left))
    (uuid "dafe7722-764a-513d-bef3-635402d289e0"))
